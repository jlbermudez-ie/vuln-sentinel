{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "orders-infra WAF rules",
  "type": "object",
  "required": [
    "default_action",
    "managed_rule_groups",
    "custom_rules"
  ],
  "additionalProperties": false,
  "properties": {
    "_comment": {
      "type": "string"
    },
    "default_action": {
      "enum": [
        "allow"
      ]
    },
    "managed_rule_groups": {
      "type": "array",
      "maxItems": 8,
      "items": {
        "type": "object",
        "required": [
          "name",
          "priority",
          "mode",
          "reason"
        ],
        "additionalProperties": false,
        "properties": {
          "name": {
            "enum": [
              "AWSManagedRulesCommonRuleSet",
              "AWSManagedRulesKnownBadInputsRuleSet",
              "AWSManagedRulesPHPRuleSet",
              "AWSManagedRulesLinuxRuleSet",
              "AWSManagedRulesSQLiRuleSet",
              "AWSManagedRulesAmazonIpReputationList"
            ]
          },
          "priority": {
            "type": "integer",
            "minimum": 1,
            "maximum": 999
          },
          "mode": {
            "enum": [
              "block",
              "count"
            ]
          },
          "version": {
            "type": [
              "string",
              "null"
            ],
            "pattern": "^Version_[0-9.]+$"
          },
          "rule_overrides_to_count": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "reason": {
            "type": "string",
            "minLength": 3,
            "maxLength": 300
          },
          "staged": {
            "type": [
              "object",
              "null"
            ],
            "additionalProperties": false,
            "required": [
              "since",
              "promote_at",
              "max_count_ratio"
            ],
            "description": "Auto tier: deployed in COUNT; vuln-sentinel promotes to BLOCK after promote_at if the counted share stays under max_count_ratio.",
            "properties": {
              "since": {
                "type": "string",
                "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
              },
              "promote_at": {
                "type": "string",
                "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
              },
              "max_count_ratio": {
                "type": "number",
                "minimum": 0,
                "maximum": 0.2
              }
            }
          },
          "watch": {
            "type": [
              "object",
              "null"
            ],
            "additionalProperties": false,
            "required": [
              "since",
              "until",
              "max_block_ratio"
            ],
            "description": "After promotion: rolled back to COUNT if the blocked share exceeds max_block_ratio before `until`.",
            "properties": {
              "since": {
                "type": "string",
                "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
              },
              "until": {
                "type": "string",
                "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
              },
              "max_block_ratio": {
                "type": "number",
                "minimum": 0,
                "maximum": 0.5
              }
            }
          },
          "hold_reason": {
            "type": [
              "string",
              "null"
            ],
            "maxLength": 300,
            "description": "Set when promotion was refused or rolled back; a human decides."
          }
        }
      }
    },
    "custom_rules": {
      "type": "array",
      "maxItems": 10,
      "items": {
        "type": "object",
        "required": [
          "name",
          "priority",
          "action",
          "header",
          "contains",
          "reason"
        ],
        "additionalProperties": false,
        "properties": {
          "name": {
            "type": "string",
            "pattern": "^[a-z0-9-]{3,64}$"
          },
          "priority": {
            "type": "integer",
            "minimum": 1,
            "maximum": 999
          },
          "action": {
            "enum": [
              "block",
              "count"
            ]
          },
          "header": {
            "type": "string",
            "pattern": "^[a-z0-9-]{1,64}$",
            "not": {
              "enum": [
                "content-length",
                "content-type",
                "host"
              ]
            },
            "description": "Text-match only. Numeric/size headers can't be compared with CONTAINS."
          },
          "contains": {
            "type": "string",
            "minLength": 3,
            "maxLength": 200,
            "pattern": "^[^<>=]",
            "description": "Literal substring. No comparison operators: WAF CONTAINS is a text match."
          },
          "reason": {
            "type": "string",
            "minLength": 3,
            "maxLength": 300
          }
        }
      }
    },
    "rate_limit": {
      "type": [
        "object",
        "null"
      ],
      "required": [
        "limit",
        "priority",
        "action"
      ],
      "additionalProperties": false,
      "properties": {
        "limit": {
          "type": "integer",
          "minimum": 100,
          "maximum": 2000000000
        },
        "priority": {
          "type": "integer",
          "minimum": 1,
          "maximum": 999
        },
        "action": {
          "enum": [
            "block",
            "count"
          ]
        }
      }
    }
  }
}
