{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "orders-infra WAF rules",
  "type": "object",
  "required": [
    "default_action",
    "managed_rule_groups",
    "custom_rules"
  ],
  "additionalProperties": false,
  "properties": {
    "_comment": {
      "type": "string"
    },
    "default_action": {
      "enum": [
        "allow"
      ]
    },
    "managed_rule_groups": {
      "type": "array",
      "maxItems": 8,
      "items": {
        "type": "object",
        "required": [
          "name",
          "priority",
          "mode",
          "reason"
        ],
        "additionalProperties": false,
        "properties": {
          "name": {
            "enum": [
              "AWSManagedRulesCommonRuleSet",
              "AWSManagedRulesKnownBadInputsRuleSet",
              "AWSManagedRulesPHPRuleSet",
              "AWSManagedRulesLinuxRuleSet",
              "AWSManagedRulesSQLiRuleSet",
              "AWSManagedRulesAmazonIpReputationList"
            ]
          },
          "priority": {
            "type": "integer",
            "minimum": 1,
            "maximum": 999
          },
          "mode": {
            "enum": [
              "block",
              "count"
            ]
          },
          "version": {
            "type": [
              "string",
              "null"
            ],
            "pattern": "^Version_[0-9.]+$"
          },
          "rule_overrides_to_count": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "reason": {
            "type": "string",
            "minLength": 3,
            "maxLength": 300
          }
        }
      }
    },
    "custom_rules": {
      "type": "array",
      "maxItems": 10,
      "items": {
        "type": "object",
        "required": [
          "name",
          "priority",
          "action",
          "header",
          "contains",
          "reason"
        ],
        "additionalProperties": false,
        "properties": {
          "name": {
            "type": "string",
            "pattern": "^[a-z0-9-]{3,64}$"
          },
          "priority": {
            "type": "integer",
            "minimum": 1,
            "maximum": 999
          },
          "action": {
            "enum": [
              "block",
              "count"
            ]
          },
          "header": {
            "type": "string",
            "pattern": "^[a-z0-9-]{1,64}$",
            "not": {
              "enum": [
                "content-length",
                "content-type",
                "host"
              ]
            },
            "description": "Text-match only. Numeric/size headers can't be compared with CONTAINS."
          },
          "contains": {
            "type": "string",
            "minLength": 3,
            "maxLength": 200,
            "pattern": "^[^<>=]",
            "description": "Literal substring. No comparison operators: WAF CONTAINS is a text match."
          },
          "reason": {
            "type": "string",
            "minLength": 3,
            "maxLength": 300
          }
        }
      }
    },
    "rate_limit": {
      "type": [
        "object",
        "null"
      ],
      "required": [
        "limit",
        "priority",
        "action"
      ],
      "additionalProperties": false,
      "properties": {
        "limit": {
          "type": "integer",
          "minimum": 100,
          "maximum": 2000000000
        },
        "priority": {
          "type": "integer",
          "minimum": 1,
          "maximum": 999
        },
        "action": {
          "enum": [
            "block",
            "count"
          ]
        }
      }
    }
  }
}
